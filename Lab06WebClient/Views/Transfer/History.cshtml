@model List<Lab06WebClient.Models.TransactionViewModel>
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3>Transaction History</h3> 
        <a asp-action="Index" class="btn btn-secondary">Back to Transfer</a>
    </div>
    <hr/>
    <table class="table table-striped table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>Transaction ID</th>
                <th>From Account</th>
                <th>To Account</th>
                <th>Amount</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                @foreach (var transaction in Model)
                {
                    <tr>
                        <td>@transaction.Id</td>
                        <td>@transaction.From</td>
                        <td>@transaction.To</td>
                        <td>@transaction.Amount.ToString("N2")</td>
                        <td>@transaction.TransferDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-3">No transactions found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>