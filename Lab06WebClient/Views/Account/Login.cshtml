@model Lab06WebClient.Models.LoginViewModel

<div>
        <h2>XYZ Digital Banking</h2>
        <form asp-action="Login" method="post">
            <div class="form-group">
                <label>Account Number</label>
                <input asp-for="AccountNumber" class="form-control" />
                <span asp-validation-for="AccountNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Password</label>
                <input asp-for="Password" class="form-control" type="password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-2">@ViewBag.Error</div>
            }
            else if (ViewData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger mt-2">@ViewData["ErrorMessage"]</div>
            }
            <button type="submit" class="btn btn-primary mt-2">Login</button>
        </form>
    
</div>

